{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hiu-yhct-standby",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
