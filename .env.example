# Browser-safe / publishable only
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-side only. Never prefix provider secrets with VITE_.
# OPENAI_MODEL is optional at runtime; gpt-5.6-luna is the server default.
# The app remains functional through deterministic local AI/RAG fallback.
ENABLE_CLOUD_AI=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Optional Gemini server provider. No mandatory software-license/setup fee.
# Adding GEMINI_API_KEY auto-enables Gemini unless ENABLE_GEMINI_AI=false is explicitly set.
# Academic Research/Exam is Gemini-first by default when Gemini is configured; set AI_ACADEMIC_PROVIDER=openai to override.
# High-volume/default tasks use Flash-Lite; deep Research uses Gemini 3.8 Flash unless overridden.
# Shared, rights-cleared academic RAG may be sent to Gemini. Keep member/private Drive context isolated by default.
# On Gemini free tier, Google may use submitted content to improve products; do not send personal, sensitive or confidential data.
GEMINI_API_KEY=
ENABLE_GEMINI_AI=true
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_RESEARCH_MODEL=gemini-3.8-flash
AI_ACADEMIC_PROVIDER=gemini
GEMINI_ALLOW_PRIVATE_CONTEXT=false
