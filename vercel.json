{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "git": {
    "deploymentEnabled": false
  },
  "rewrites": [
    {"source": "/research", "destination": "/"},
    {"source": "/profile", "destination": "/"},
    {"source": "/schedule", "destination": "/"},
    {"source": "/exam", "destination": "/"},
    {"source": "/drl", "destination": "/"},
    {"source": "/notifications", "destination": "/"},
    {"source": "/garden", "destination": "/"},
    {"source": "/messages", "destination": "/"},
    {"source": "/admin", "destination": "/"},
    {"source": "/acc", "destination": "/"},
    {"source": "/smart-herb", "destination": "/"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Permissions-Policy", "value": "camera=(), geolocation=(), payment=(), usb=()"}
      ]
    }
  ]
}
